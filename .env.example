# Hugging Face authentication for gated diarization models
HF_TOKEN=

# Select one overlap verifier: gemma4, gemini, gemini-flash-lite, or vibevoice
OVERLAP_VERIFIER=gemini

# Gemini overlap verification
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Use OVERLAP_VERIFIER=gemini-flash-lite for gemini-3.1-flash-lite.

# Local Unsloth Studio overlap verification
UNSLOTH_HOST=localhost
UNSLOTH_PORT=8888
# UNSLOTH_MODEL=unsloth/gemma-4-12b-it-GGUF
# UNSLOTH_API_KEY=

# Optional full-URL override; takes precedence over UNSLOTH_HOST and UNSLOTH_PORT
# UNSLOTH_ENDPOINT=http://localhost:8888/v1/chat/completions

# VibeVoice-ASR speaker-count purity (isolated .venv-vibevoice on the model server)
# OVERLAP_VERIFIER=vibevoice
# VIBEVOICE_MODEL=microsoft/VibeVoice-ASR-HF
# VIBEVOICE_PYTHON=
